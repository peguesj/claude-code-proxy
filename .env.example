# Required API Keys
ANTHROPIC_API_KEY="your-anthropic-api-key" # Needed if proxying *to* Anthropic
PROXY_API_KEY="your-proxy-api-key" # Optional: set to require clients to present a proxy API key instead of sending Anthropic keys
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="your-google-ai-studio-key"

# Optional settings profiles. Profiles let you keep multiple accounts,
# subscriptions, Azure resources, and provider instances in profiles.json.
# Secrets can stay in env vars (`api_key_env`) or macOS Keychain (`api_key_keychain`).
# CCP_PROFILES_FILE="/Users/jeremiah/Developer/claude-code-proxy/profiles.json"
# CCP_PROFILE="azure-sponsorship"

# Azure OpenAI (used as a fallback when ANTHROPIC_API_KEY is not set, or when PREFERRED_PROVIDER=azure)
# AZURE_API_KEY and AZURE_API_BASE allow the proxy to forward Anthropic-style requests to Azure OpenAI deployments
# Set AZURE_API_KEY="your-azure-openai-api-key"
# Set AZURE_API_BASE="https://your-resource.openai.azure.com/"
# Optionally set AZURE_API_VERSION (defaults to 2025-04-01-preview)
# AZURE_API_VERSION="2025-04-01-preview"

# Azure AI Foundry (used when PREFERRED_PROVIDER=azure_ai)
# AZURE_AI_API_KEY, AZURE_AI_API_BASE, and AZURE_AI_API_VERSION allow the proxy to forward requests to Azure AI Foundry
# This provides access to the full Azure AI model catalog including OpenAI-compatible models and other AI services
# Set AZURE_AI_API_KEY="your-azure-ai-foundry-api-key"
# Set AZURE_AI_API_BASE="https://your-project.services.ai.azure.com/models"
# Optionally set AZURE_AI_API_VERSION (defaults to 2025-04-01-preview)
# AZURE_AI_API_VERSION="2025-04-01-preview"
# Optional resource context for the menu bar Model Manager and catalog diagnostics
# AZURE_AI_RESOURCE_GROUP="your-resource-group"
# AZURE_AI_ACCOUNT_NAME="your-ai-services-account"
# AZURE_AI_LOCATION="eastus2"
#
# Azure resource context — required by the menu bar Model Manager to browse the
# catalog and deploy new models via `az` CLI. Not needed for runtime request routing.
# AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
# AZURE_RESOURCE_GROUP="your-resource-group"
# AZURE_ACCOUNT_NAME="your-cognitive-services-account"

# Optional: Provider Preference and Model Mapping
# Controls which provider (google, openai, or anthropic) is preferred for mapping haiku/sonnet.
# Defaults to openai if not set.
# Set to "anthropic" for "just an Anthropic proxy" mode (no remapping)
PREFERRED_PROVIDER="openai"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional: Specify the exact models to map haiku/sonnet to.
# If PREFERRED_PROVIDER=google, these MUST be valid Gemini model names known to the server.
# Defaults to gemini-2.5-pro and gemini-2.5-flash if PREFERRED_PROVIDER=google.
# Defaults to gpt-4.1 and gpt-4.1-mini if PREFERRED_PROVIDER=openai.
# FRONTIER_MODEL maps from Claude Opus (the most capable tier). Defaults to gpt-6-astra.
# These are IGNORED when PREFERRED_PROVIDER=anthropic (models are not remapped).
# BIG_MODEL="gpt-4.1"
# SMALL_MODEL="gpt-4.1-mini"
# FRONTIER_MODEL="gpt-6-astra"

# Opus 1M aliases use output_config.effort (or a -low/-medium/-high suffix):
#   low -> gpt-5.6-luna, medium/med -> gpt-5.6-terra, high -> gpt-5.6-sol.
# A bare opus[1m] defaults to medium. Normal Opus still uses FRONTIER_MODEL.
# These model names can use custom deployments in AZURE_DEPLOYMENT_MAP.
# GPT-6 Astra uses Responses; GPT-5.6 tool requests also use Responses so that
# reasoning effort is preserved. Haiku/SMALL_MODEL and Sonnet/BIG_MODEL do not change.

# Example Google mapping:
# PREFERRED_PROVIDER="google"
# BIG_MODEL="gemini-2.5-pro"
# SMALL_MODEL="gemini-2.5-flash"

# Example Google with vertex AI auth via ADC:
# PREFERRED_PROVIDER="google"
# USE_VERTEX_AUTH=true
# BIG_MODEL="gemini-2.5-pro"
# SMALL_MODEL="gemini-2.5-flash"

# Example Azure AI Foundry mapping:
# PREFERRED_PROVIDER="azure_ai"
# BIG_MODEL="gpt-5.2"
# SMALL_MODEL="gpt-5-mini"
# FRONTIER_MODEL="gpt-6-astra"
# AZURE_AI_API_KEY="your-azure-ai-foundry-api-key"
# AZURE_AI_API_BASE="https://your-project.services.ai.azure.com/models"
# AZURE_AI_API_VERSION="2025-04-01-preview"
#
# Available Azure OpenAI deployments verified August 3, 2026:
#   Standard SKU:               gpt-4o, gpt-4o-mini, gpt-4.1, gpt-4.1-mini, o1, o4-mini
#   GlobalStandard SKU:         gpt-5, gpt-5-mini, gpt-5.2, gpt-5.2-codex,
#                               gpt-5.5, gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol,
#                               o3, o3-mini, codex-mini, audio, and model-router
#   DataZoneStandard SKU:       gpt-5-nano, gpt-5.1, gpt-5.3-codex

# Example "just an Anthropic proxy" mode:
# PREFERRED_PROVIDER="anthropic"
# (BIG_MODEL and SMALL_MODEL are ignored in this mode)
